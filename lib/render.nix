{ lib }:
rec {
  # Fails the build if any value in `colors` isn't a hex string or the
  # literal "NONE" — catches typos before they reach a generated file.
  assertHexPalette = colors:
    let
      isValid = v: v == "NONE" || (builtins.match "#[0-9A-Fa-f]{6}" v != null);
      bad = lib.filterAttrs (_: v: !isValid v) colors;
    in
    if bad == { }
    then colors
    else throw "nord: non-hex values in palette: ${builtins.toJSON bad}";

  # { fg = "#D8DEE9"; bg = "#2E3440"; } -> `return {\n  fg = "#D8DEE9",\n  ...\n}\n`
  toLuaTable = colors:
    let
      names = builtins.attrNames colors;
      line = name: "  ${name} = \"${colors.${name}}\",";
    in
    ''
      -- Generated by hanapedia/nord — do not edit by hand.
      return {
      ${lib.concatStringsSep "\n" (map line names)}
      }
    '';

  # { palette = { "0" = "#..."; ... }; background = "#..."; ... }
  # -> ghostty's `key = value` theme file format.
  toKeyValue = rows:
    lib.concatStringsSep "\n" (map ({ key, value }: "${key} = ${value}") rows) + "\n";
}
