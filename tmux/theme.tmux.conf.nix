# Renders a tmux conf snippet (plain `set-option` statements) from a
# tmux-roles attrset (see ../lib/tmux-roles.nix).
roles: ''
  # Generated by hanapedia/nord — do not edit by hand.
  set-option -g status-style "bg=${roles.status_bg},fg=${roles.status_fg}"
  set-option -g window-status-current-style "fg=${roles.window_active_fg},bold"
  set-option -g window-status-style "fg=${roles.window_inactive_fg}"
  set-option -g pane-border-style "fg=${roles.pane_border_fg}"
  set-option -g pane-active-border-style "fg=${roles.pane_active_border_fg}"
  set-option -g message-style "bg=${roles.message_bg},fg=${roles.message_fg}"
  set-option -g message-command-style "bg=${roles.message_bg},fg=${roles.message_fg}"
  set-option -g mode-style "fg=${roles.mode_fg},bold"
  set-option -g clock-mode-colour "${roles.clock_fg}"
''
